% ==============================================================================
%  readingnote.sty — robust reading-note box for study annotations
%
%  Usage:
%    \usepackage{readingnote}            % in the preamble
%
%    \begin{readingnote}[Q1]{Short question title}   % [id] is optional
%      ... explanation body (any LaTeX: lists, display math, ...) ...
%    \end{readingnote}
%
%  Display switches (anywhere in the body):
%    \noteson               show all notes (the default)
%    \notesoff              hide all notes
%    \shownotes{Q3,Q7}      show only the notes with the listed [id]
%
%  Robustness notes (vs. the old inline tcolorbox hack):
%    * The title is typeset as an ordinary bold paragraph — it WRAPS naturally,
%      handles long questions and inline math, and never uses \resizebox or
%      tcolorbox's fragile title machinery.
%    * The [id] matching uses expl3 (no \forcsvlist / \ifstrequal pitfalls).
%    * The body is read LAZILY (NOT captured with environ's \NewEnviron or
%      xparse's +b).  Eager capture froze `&' at catcode 4 and broke nested
%      tikz-cd.  Lazy reading keeps tikz-cd's standard `&' syntax working AND
%      still works inside \input/\include sub-files.
%    * The show/hide switches work by choosing, in the begin-code, whether to
%      open the box or swallow the body into a throw-away \vbox (see below).
%
%  tikz-cd: standard syntax is fully supported inside a readingnote:
%      \begin{tikzcd}
%        A \arrow[r] & B
%      \end{tikzcd}
%  (aligned / align / tabular also keep working, since their `&' stays catcode 4.)
% ==============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{readingnote}[2026/08/15 v1 reading-note box]

\RequirePackage{xcolor}
\RequirePackage{xparse}
\RequirePackage{tcolorbox}
\tcbuselibrary{breakable, skins}

% ----------------------------------------------------------------------------
% Display switches (expl3)
% ----------------------------------------------------------------------------
\ExplSyntaxOn
\bool_new:N \g__rn_all_bool
\bool_new:N \g__rn_some_bool
\seq_new:N  \g__rn_shown_seq

\NewDocumentCommand \noteson {} {
  \bool_gset_true:N  \g__rn_all_bool
  \bool_gset_false:N \g__rn_some_bool
}
\NewDocumentCommand \notesoff {} {
  \bool_gset_false:N \g__rn_all_bool
  \bool_gset_false:N \g__rn_some_bool
}
\NewDocumentCommand \shownotes { m } {
  \bool_gset_false:N \g__rn_all_bool
  \bool_gset_true:N  \g__rn_some_bool
  \seq_gset_from_clist:Nn \g__rn_shown_seq {#1}
}

\prg_new_conditional:Npnn \rn_if_shown:n #1 { T, F, TF } {
  \bool_if:NTF \g__rn_all_bool
    { \prg_return_true: }
    {
      \bool_if:NTF \g__rn_some_bool
        { \seq_if_in:NnTF \g__rn_shown_seq {#1} { \prg_return_true: } { \prg_return_false: } }
        { \prg_return_false: }
    }
}

% default: show everything
\bool_gset_true:N \g__rn_all_bool
\ExplSyntaxOff

% ----------------------------------------------------------------------------
% The box (defined OUTSIDE \ExplSyntaxOn so pgfkeys keys with spaces work)
% ----------------------------------------------------------------------------
\newtcolorbox{rnbox}{%
  breakable, enhanced,
  colback=blue!4!white, colframe=blue!45!black,
  boxrule=0.7pt, arc=1.5mm,
  left=7pt, right=7pt, top=6pt, bottom=6pt,
  before upper={\setlength{\emergencystretch}{2em}}
}

% ----------------------------------------------------------------------------
% The environment: readingnote[id]{title}
% ----------------------------------------------------------------------------
% IMPORTANT: the body is read LAZILY (not captured with environ's \NewEnviron or
% xparse's +b).  Eager body capture freezes the catcode of `&' at 4, so a nested
% tikzcd can no longer make `&' active and `\begin{tikzcd} ... & ... \end{tikzcd}`
% fails with "Single ampersand used with wrong catcode".
%
% Reading the body lazily keeps tikz-cd's own \begin code in charge of `&'
% (standard syntax works), while aligned/align/tabular -- whose `&' stays at
% catcode 4 -- keep working unchanged.
%
% The show/hide switches (\noteson / \notesoff / \shownotes{}) are implemented by
% choosing, in the begin-code, whether to open the box or to swallow the body into
% a throw-away \vbox (\setbox + \bgroup).  The matching end-code is stored in
% \rn_end_cmd.  No body capture is involved, so `&' is never frozen.
%
% (hidden branch reads the body lazily instead of skipping it, so a note body is
%  still tokenised/executed even when hidden; but it keeps tikz-cd `&' working.)
% ----------------------------------------------------------------------------
\ExplSyntaxOn
\NewDocumentEnvironment{readingnote}{ O{} m }{%
  \rn_if_shown:nTF {#1} {%
    \cs_set:Npn \rn_end_cmd { \end{rnbox} }%
    \begin{rnbox}%
      {\bfseries\sffamily\color{blue!50!black}#2\par}%
      \smallskip
  }{%
    \cs_set:Npn \rn_end_cmd { \egroup }%
    \setbox\z@\vbox\bgroup
  }%
}{%
  \rn_end_cmd
}
\ExplSyntaxOff

\endinput
